  "db_name": "PostgreSQL",
  "query": "SELECT guilds.*\n            FROM guilds\n            WHERE EXISTS (\n                SELECT 1\n                FROM guild_members\n                WHERE guild_members.guild_id = guilds.id\n                  AND guild_members.member_id = $1\n              )\n              AND $2 > guilds.id\n            ORDER BY guilds.id DESC\n            LIMIT 50;",
