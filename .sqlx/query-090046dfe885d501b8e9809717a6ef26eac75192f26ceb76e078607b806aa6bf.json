  "query": "SELECT users.id AS user_id, users.nickname AS nickname, users.pfp AS pfp, guild_members.rank AS \"rank: RankT\" FROM\n            users \n            JOIN guild_members ON guild_members.member_id = users.id \n            WHERE guild_members.guild_id = $1\n            ORDER BY guild_members.member_id DESC\n            LIMIT 50;",
