  "query": "SELECT users.id AS user_id, nickname, pfp FROM users \n            JOIN relations rel ON rel.relating_user = users.id \n            WHERE (rel.state, rel.related_user) = ($1, $2)\n            ORDER BY users.id DESC\n            LIMIT 50;",
